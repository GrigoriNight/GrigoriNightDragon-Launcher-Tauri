{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrigoriNightDragon",
  "version": "1.0.0",
  "identifier": "com.grigorinightdragon.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GrigoriNightDragon Launcher",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../game/*"
    ]
  }
}
